# --- secrets ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- data (large binaries never live in git; >5 MB goes to Hugging Face Datasets) ---
*.parquet
*.duckdb
data/
# Date-stamped scraper dumps. Local working copies only; the published archive goes to HF Datasets.
archives/

# --- run logs ---
# Local scraper/flow stdout capture. Evidence worth keeping goes into PROGRESS.md, not here.
*.log

# --- agent tickets (see ~/.config/opencode/runtime/README.md) ---
# Briefs and progress are working notes. Reports are kept: they are what was actually verified.
.agent/*-brief.md
.agent/*-progress.md

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
.neon
# Playwright MCP writes screenshots and accessibility snapshots here during UI checks.
.playwright-mcp/

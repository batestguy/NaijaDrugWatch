     Spec("health", HEALTH_SQL, lambda rows: rows, time_tolerance=300.0, float_tolerance=1.0),
     Spec("ledger", LEDGER_SQL, lambda rows: rows, time_tolerance=300.0),
     Spec("pharmacies", PHARMACY_SQL, derive_pharmacies),
 ]
 
